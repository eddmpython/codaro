{
  "schemaVersion": 1,
  "surface": "/api/classroom",
  "rationale": "v0.0.12 shipped the active classroom feature, so one published release must answer legacy URLs with HTTP 410 before the tombstone router is deleted.",
  "compatibilityWindow": {
    "lastReleaseWithActiveClassroom": "v0.0.12",
    "activeClassroomMarkerPath": "src/codaro/api/classroomRouter.py",
    "firstReleaseWithTombstone": null
  },
  "tombstone": {
    "routerPath": "src/codaro/api/classroomRetirementRouter.py",
    "factory": "createClassroomRetirementRouter",
    "httpStatus": 410,
    "errorCode": "classroom_retired",
    "wiringPaths": [
      "src/codaro/server.py",
      "src/codaro/api/__init__.py"
    ],
    "localCommandPrefixes": [
      "codaro classroom audit",
      "codaro classroom export",
      "codaro classroom verify",
      "codaro classroom purge"
    ]
  },
  "retainedLocalMigration": {
    "modulePath": "src/codaro/migrations/classroomArchive.py",
    "operations": [
      "auditClassroomArchive",
      "exportClassroomArchive",
      "verifyClassroomArchive",
      "purgeClassroomArchive",
      "resumeClassroomPurge"
    ]
  }
}
